# ==============================================================================
# EduAtlas Frontend Environment Configuration Example
# ==============================================================================
# VITE_API_URL: Endpoint URL backend EduAtlas API
# Contoh: http://localhost:4000/api/v1
#
# PENTING (APPLICATION FLOW & OFFLINE CONSTANTS FALLBACK):
# Jika VITE_API_URL tidak diisi, dikosongkan (""), atau jika server backend
# tidak berjalan (offline / connection refused / timeout), maka Frontend EduAtlas
# akan secara otomatis beralih menggunakan data snapshot dari folder `constants/`.
#
# Hal ini menjamin seluruh visualisasi grafik (Recharts & ECharts), peta interaktif
# (Leaflet & MapLibre), data grid / tabel, kalender akademik, diagram alir (ReactFlow),
# serta fitur ekspor data tetap dapat berjalan lancar dan interaktif tanpa error.
# ==============================================================================
VITE_API_URL=http://localhost:4000/api/v1
